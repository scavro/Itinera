{
  "name": "itinera",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" src/styles.css index.html package.json premium-ui.json tsconfig.json DESIGN.md UX-CONTRACT.md",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" src/styles.css index.html package.json premium-ui.json tsconfig.json DESIGN.md UX-CONTRACT.md",
    "tokens": "node scripts/generate-tokens.mjs --check"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/newsreader": "^5.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vitest": "^3.2.0",
    "prettier": "^3.6.0"
  }
}
